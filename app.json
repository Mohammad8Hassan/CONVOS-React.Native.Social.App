{
  "expo": {
    "name": "CONVOS",
    "slug": "CONVOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Imgs/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohammadHassan.CONVOS"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Imgs/adaptive-icon.png",
        "backgroundColor": "#261235"
      },
      "package": "com.mohammadHassan.CONVOS",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/Imgs/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a40b7fe3-e425-45cf-bda6-acecfacc0465"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/Imgs/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#261235"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you customize your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Imgs/trayIcon.png"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4623463929646643~6794231765"
        }
      ]
    ]
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4623463929646643~6794231765"
  }
}