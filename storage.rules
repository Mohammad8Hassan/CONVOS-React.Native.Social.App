rules_version = '2';

// DRAFT, not tested against the emulator (Firestore rules are). The app only uses one path:
// "Profile Photos/<uid>" (screens/EditProfile.js). Download URLs that are already stored keep working
// for everybody regardless of these rules (they carry a token); these rules cover SDK access.
// Before deploying, compare with what is set now: Firebase console > Storage > Rules.
service firebase.storage {
  match /b/{bucket}/o {

    match /{folder}/{uid} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && folder == 'Profile Photos'
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // everything else is closed
  }
}
