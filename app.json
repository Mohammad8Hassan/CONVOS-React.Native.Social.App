{
  "expo": {
    "name": "CONVOS",
    "slug": "CONVOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Imgs/icon2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Imgs/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#39204d"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Imgs/icon2.png",
        "backgroundColor": "#39204d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#39204d"
    }
  }
}
