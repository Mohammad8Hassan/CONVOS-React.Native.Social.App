rules_version = '2';

// PHASE 1 rules (see CLAUDE.md "Conversation passwords").
//
// Before: one rule `match /{document=**} { allow read, write: if request.auth != null; }`.
// Firestore rules can only *allow*, never deny, so that wildcard would override any rule protecting a
// collection. It is therefore replaced by one explicit rule per collection the app uses, with the SAME
// permission as before (any signed-in user), so the currently published app keeps working.
// The only change in behaviour: the two server-only collections below are closed to clients.
//
// This is still very permissive (any signed-in user can read/write any user's or conversation's data).
// Tightening each collection is the next phase; do it after the app update that uses the functions.
service cloud.firestore {
  match /databases/{database}/documents {

    // Hashed conversation passwords + join-attempt counters.
    // Only the Cloud Functions touch these (the Admin SDK bypasses rules).
    match /ConversationSecrets/{conversationId} {
      allow read, write: if false;
    }
    match /JoinAttempts/{attemptId} {
      allow read, write: if false;
    }

    // Everything the app uses today (collections found in the code: Users + subcollections
    // Friends / Sent Requests / Received Requests / Blocked / My Conversations / Friends Invites /
    // Other Invites, Conversations + Participants / Comments, and legacy Posts).
    match /Users/{path=**} {
      allow read, write: if request.auth != null;
    }
    match /Conversations/{path=**} {
      allow read, write: if request.auth != null;
    }
    match /Posts/{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}
